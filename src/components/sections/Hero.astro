---
import { Button } from "@/components/ui/button";
import { site } from "@/data/site";
---

<section class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-32 text-center">
  <h1 class="font-heading text-5xl font-semibold tracking-tight">{site.name}</h1>
  <p class="max-w-xl text-lg text-muted-foreground">{site.description}</p>
  <Button size="lg">Get in touch</Button>
</section>
