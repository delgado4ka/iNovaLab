---
import { ChevronDownIcon } from "lucide-react";
import { stories } from "@/data/stories";
---

<section id="stories" class="section-y bg-card">
  <div class="page-container">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{stories.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{stories.intro}</p>
      <a
        href={stories.dzenUrl}
        class="mt-5 inline-block font-medium underline decoration-gold decoration-2 underline-offset-4 hover:decoration-foreground"
        target="_blank"
        rel="noopener"
      >
        {stories.dzenLabel}
      </a>
    </div>

    <div class="mt-14 grid gap-14 lg:grid-cols-2 lg:gap-16">
      {
        stories.groups.map((group) => {
          const visible = group.story.answers.slice(0, stories.visibleAnswers);
          const hidden = group.story.answers.slice(stories.visibleAnswers);
          return (
            <article>
              <h3 class="text-sm text-muted-foreground">{group.title}</h3>
              <p class="mt-3 font-serif text-2xl">{group.story.person}</p>
              <p class="mt-1 text-muted-foreground">{group.story.context}</p>

              <dl class="mt-8 space-y-7 border-l-2 border-gold/60 pl-6">
                {visible.map((item) => (
                  <div>
                    <dt class="font-medium">{item.q}</dt>
                    <dd class="mt-2 font-serif text-lg leading-8">{item.a}</dd>
                  </div>
                ))}
              </dl>

              {hidden.length > 0 && (
                <details class="group mt-7 pl-6">
                  <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-sm font-medium [&::-webkit-details-marker]:hidden">
                    {stories.moreLabel}
                    <ChevronDownIcon className="size-4 transition-transform group-open:rotate-180" aria-hidden="true" />
                  </summary>
                  <dl class="mt-7 space-y-7 border-l-2 border-gold/60 pl-6 -ml-6">
                    {hidden.map((item) => (
                      <div>
                        <dt class="font-medium">{item.q}</dt>
                        <dd class="mt-2 font-serif text-lg leading-8">{item.a}</dd>
                      </div>
                    ))}
                  </dl>
                </details>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>
