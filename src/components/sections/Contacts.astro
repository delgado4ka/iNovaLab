---
import { MailIcon, MapPinIcon, MessageCircleIcon, PhoneIcon, SendIcon } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { contactsBlock } from "@/data/contacts";
import { site } from "@/data/site";

const { contacts } = site;

const channels = [
  { label: "Telegram", value: `@${contacts.telegram.split("/").pop()}`, href: contacts.telegram, Icon: SendIcon },
  { label: "WhatsApp", value: contacts.phone, href: contacts.whatsapp, Icon: MessageCircleIcon },
  { label: "Почта", value: contacts.email, href: `mailto:${contacts.email}`, Icon: MailIcon },
  { label: "Телефон", value: contacts.phone, href: `tel:${contacts.phone.replace(/[^\d+]/g, "")}`, Icon: PhoneIcon },
];
---

<section id="contacts" class="section-y bg-band text-band-foreground">
  <div class="page-container grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{contactsBlock.title}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-band-muted">{contactsBlock.text}</p>

      <ul class="mt-10 border-t border-band-border">
        {
          channels.map(({ label, value, href, Icon }) => (
            <li>
              <a
                href={href}
                class="group flex items-center gap-4 border-b border-band-border py-4"
                {...(href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
              >
                <span class="grid size-10 shrink-0 place-items-center rounded-full border border-band-border transition-colors group-hover:border-gold group-hover:text-gold">
                  <Icon className="size-[1.1rem]" aria-hidden="true" />
                </span>
                <span>
                  <span class="block text-xs text-band-muted">{label}</span>
                  <span class="block">{value}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 flex items-center gap-3 text-sm text-band-muted">
        <MapPinIcon className="size-4" aria-hidden="true" />
        {contacts.location}
      </p>
    </div>

    <div class="lg:col-span-5 lg:col-start-8 lg:self-center">
      <div class="rounded-2xl border border-band-border bg-band-foreground/[0.04] p-7 sm:p-9">
        <h3 class="text-2xl font-semibold tracking-tight">{contactsBlock.questionnaire.title}</h3>
        <p class="mt-4 leading-relaxed text-band-muted">{contactsBlock.questionnaire.text}</p>
        <a href={site.questionnaireUrl} class={cn(buttonVariants({ size: "xl", className: "mt-8 w-full sm:w-auto" }))}>{contactsBlock.questionnaire.button}</a>
      </div>
    </div>
  </div>
</section>
