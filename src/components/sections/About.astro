---
import { about } from "@/data/about";
import { site } from "@/data/site";
---

<section id="about" class="section-y">
  <div class="page-container grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{about.storyTitle}</h2>
      <blockquote class="mt-8 border-l-2 border-gold pl-6 font-serif text-2xl leading-snug italic sm:text-[1.7rem]">
        {about.quote}
      </blockquote>
    </div>

    <div class="lg:col-span-7">
      <div class="max-w-[62ch] space-y-6 font-serif text-lg leading-8">
        {about.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-10">
        <span class="block font-serif text-xl">{site.founder.name}</span>
        <span class="mt-1 block text-sm text-muted-foreground">{site.founder.roleEn}</span>
      </p>
    </div>
  </div>
</section>
