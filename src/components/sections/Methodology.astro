---
import { methodology } from "@/data/methodology";

const lastIndex = methodology.steps.length - 1;
---

<section id="method" class="section-y bg-card">
  <div class="page-container">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{methodology.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{methodology.intro}</p>
    </div>

    <!-- A real sequence, so the steps are numbered and joined by the dotted trajectory. -->
    <ol class="mt-14 grid gap-10 lg:grid-cols-4 lg:gap-8">
      {
        methodology.steps.map((step, i) => (
          <li class="relative pl-16 lg:pt-16 lg:pl-0">
            {i < lastIndex && (
              <>
                <span
                  class="absolute top-12 -bottom-10 left-5 border-l-2 border-dotted border-gold/70 lg:hidden"
                  aria-hidden="true"
                />
                <span
                  class="absolute top-5 -right-8 left-12 hidden border-t-2 border-dotted border-gold/70 lg:block"
                  aria-hidden="true"
                />
              </>
            )}
            <span
              class:list={[
                "absolute top-0 left-0 grid size-10 place-items-center rounded-full border-2 border-gold font-heading text-sm font-semibold",
                i === lastIndex ? "bg-gold text-navy" : "bg-card",
              ]}
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="pt-1.5 text-xl font-semibold lg:pt-0">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
