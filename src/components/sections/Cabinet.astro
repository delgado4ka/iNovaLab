---
import Icon from "@/assets/brand/inovalab-icon-reversed.svg";
import { cabinet } from "@/data/cabinet";

const { preview } = cabinet;
---

<section id="cabinet" class="section-y">
  <div class="page-container grid gap-12 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{cabinet.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{cabinet.intro}</p>
      <dl class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-1">
        {
          cabinet.features.map((feature) => (
            <div>
              <dt class="font-heading font-medium">{feature.title}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-muted-foreground">{feature.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Illustrated preview of the future client account, built in HTML so it adapts to theme and screen. -->
    <figure class="lg:col-span-7">
      <div class="overflow-hidden rounded-2xl border bg-card shadow-[0_24px_60px_-30px_rgb(11_31_51/0.35)]">
        <div class="flex items-center justify-between gap-4 bg-band px-5 py-3.5 text-band-foreground">
          <span class="text-sm font-medium">{preview.student}</span>
          <Icon class="h-6 w-auto" aria-hidden="true" />
        </div>

        <div class="grid gap-px bg-border sm:grid-cols-2">
          <div class="bg-card p-5">
            <p class="text-sm font-medium">Карта навыков</p>
            <ul class="mt-4 space-y-3.5">
              {
                preview.skills.map((skill) => (
                  <li>
                    <div class="flex justify-between text-xs text-muted-foreground">
                      <span>{skill.name}</span>
                      <span>{skill.value}</span>
                    </div>
                    <div class="mt-1.5 h-1.5 rounded-full bg-muted">
                      <div class="h-full rounded-full bg-gold" style={{ width: `${skill.value}%` }} />
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="bg-card p-5">
            <p class="text-sm font-medium">Воронка вузов</p>
            <ul class="mt-4 space-y-2">
              {
                preview.funnel.map((row, i) => (
                  <li
                    class="flex items-center justify-between rounded-md bg-muted px-3 py-2 text-sm"
                    style={{ marginInline: `${i * 0.75}rem` }}
                  >
                    <span>{row.label}</span>
                    <span class="font-medium">{row.count}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="bg-card p-5 sm:col-span-2">
            <p class="text-sm font-medium">Ближайшие дедлайны</p>
            <ul class="mt-3 divide-y">
              {
                preview.deadlines.map((deadline) => (
                  <li class="flex items-center gap-4 py-2.5 text-sm">
                    <span class="w-14 shrink-0 text-muted-foreground">{deadline.date}</span>
                    <span>{deadline.name}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-3 flex items-center gap-2.5 rounded-md bg-muted px-3 py-2.5 text-sm">
              <span class="size-2 shrink-0 rounded-full bg-gold" aria-hidden="true" />
              {preview.nextSession}
            </p>
          </div>
        </div>
      </div>
      <figcaption class="mt-3 text-sm text-muted-foreground">{preview.caption}</figcaption>
    </figure>
  </div>
</section>
